# MealMate backend environment template — copy to .env and adjust
PORT=4000
# PostgreSQL connection string (database must exist; tables are created on startup)
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/mealmate
# Set to true for managed PostgreSQL providers that require TLS
PGSSL=false

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# 'Today' is resolved in this timezone (Myanmar local time)
APP_TIMEZONE=Asia/Yangon

# Allowed CORS origins ('*' or comma-separated list)
CORS_ORIGIN=*

# First-run seeding of the campus catalog and the admin account
SEED_CATALOG=true
SEED_ADMIN=true
ADMIN_NAME=MealMate Admin
ADMIN_EMAIL=admin@mealmate.local
# Quote values that contain '#', otherwise dotenv treats the rest as a comment.
ADMIN_PASSWORD=replace-with-your-own-strong-password